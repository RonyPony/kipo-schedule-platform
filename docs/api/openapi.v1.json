  "components": {
    "schemas": {
      "BusinessDetails": {
        "required": [
          "id",
          "name",
          "activity",
          "phone",
          "countryCode",
          "timeZoneId",
          "weekStartsOn",
          "slotMinutes",
          "role",
          "rowVersion"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "activity": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          },
          "timeZoneId": {
            "type": "string"
          },
          "weekStartsOn": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "slotMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "role": {
            "type": "string"
          },
          "rowVersion": {
            "type": "string"
          }
        }
      },
      "CsrfToken": {
        "required": [
          "token",
          "headerName"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "headerName": {
            "type": "string"
          }
        }
      },
      "CurrentUser": {
        "required": [
          "id",
          "displayName",
          "email",
          "state",
          "emailConfirmed"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "emailConfirmed": {
            "type": "boolean"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ServiceStatus": {
        "required": [
          "product",
          "status",
          "apiVersion"
        ],
        "type": "object",
        "properties": {
          "product": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string"
          }
        }
      },
      "UpdateBusinessRequest": {
        "required": [
          "name",
          "activity",
          "phone",
          "rowVersion"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "activity": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "rowVersion": {
            "type": "string"
          }
